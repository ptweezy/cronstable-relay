{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    // Runtime and binding types come from worker-configuration.d.ts,
    // generated by `wrangler types` (which supersedes the old
    // @cloudflare/workers-types package); the pool contributes the
    // "cloudflare:test" module declaration.
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "worker-configuration.d.ts"]
}
