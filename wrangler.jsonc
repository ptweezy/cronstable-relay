{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cronstable-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",

  // https://relay.cronstable.com/ is the relay's only address: the
  // hostname daemons put in push.relay.url, and the one an operator can
  // check against this source.  The workers.dev route and the per-version
  // preview URLs are both off, so there is no second, unversioned way in
  // (preview URLs default to ON whenever workers_dev is enabled).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "relay.cronstable.com", "custom_domain": true }],

  // Workers Logs keeps the relay's own log lines, which never hold a
  // device token or a client address.  Invocation logs stay off: each
  // one would add the request's own metadata, which can identify the
  // client, and the privacy policy says the relay keeps no IP address.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },

  // DEVICE: one object per push token (delivery policy, quota, digests,
  // the verified entitlement).  ENTITLEMENT: one per App Store
  // transaction (the hashes of the devices it lifts, for the
  // per-transaction cap, and the mark a refund or revocation leaves).
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE", "class_name": "DeviceState" },
      { "name": "ENTITLEMENT", "class_name": "EntitlementState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceState"] },
    { "tag": "v2", "new_sqlite_classes": ["EntitlementState"] }
  ],

  // EDGE_LIMITER: POST / requests per client address (cf-connecting-ip:
  // an IPv4 address, or an IPv6 address's /64), checked before the relay
  // reads the body or reaches any Durable Object; past the limit it
  // answers 429 with Retry-After: 60.  A daemon never retries a 429, so
  // the limit sits far above any honest burst: a daemon posts once per
  // paired device for each alert, and 6000 a minute covers an incident
  // of 60 alerts to 100 devices.  Daemons behind one NAT address share
  // the count, and the event lane doesn't exempt an approval gate from
  // it.  Every rate-limit binding with the same namespace_id shares its
  // counters, across all of the account's Workers, so a self-hosted
  // relay picks an id no other Worker on its account uses.  The binding
  // counts per Cloudflare location and approximately; the zone
  // rate-limiting rule (README, "Deploy") runs before the Worker and
  // guards its budgets.
  "ratelimits": [
    { "name": "EDGE_LIMITER", "namespace_id": "6060", "simple": { "limit": 6000, "period": 60 } }
  ],

  // Non-secret configuration.  The Apple credentials are secrets:
  //   wrangler secret put APNS_TEAM_ID
  //   wrangler secret put APNS_KEY_ID
  //   wrangler secret put APNS_AUTH_KEY   (paste the whole .p8 PEM)
  //
  // Every RELAY_* knob has a default in code (README, "Environment"),
  // so only the ones worth seeing at a glance are set here:
  //   RELAY_ACCEPT_SANDBOX_ENTITLEMENTS  "true" accepts Sandbox (TestFlight,
  //     Xcode) StoreKit transactions as Pro proof; "false" refuses them.
  // Also available: RELAY_FREE_MONTHLY_FORWARDS (500),
  // RELAY_DIGEST_INTERVAL_S (3600), RELAY_BURST_DIGEST_INTERVAL_S (300),
  // RELAY_PRO_PRODUCT_IDS (the two com.cronstable.app.pro.* ids),
  // RELAY_PRO_DEVICES_PER_TRANSACTION (5), RELAY_PRO_DEVICE_SLOT_TTL_S
  // (5184000), RELAY_PRO_GRACE_S (1382400), RELAY_APNS_TIMEOUT_S (8),
  // and the delivery-policy windows listed in the README.
  "vars": {
    "APNS_TOPIC": "com.cronstable.app",
    "APNS_ENVIRONMENT": "auto",
    "RELAY_ACCEPT_SANDBOX_ENTITLEMENTS": "true"
  }
}
