{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cronstable-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",

  // The relay answers at https://relay.cronstable.com/ (the hostname
  // daemons put in push.relay.url).  workers_dev stays on as a fallback
  // path to the same Worker; it costs nothing and keeps a way in if the
  // custom domain is ever mid-change.
  "workers_dev": true,
  "routes": [{ "pattern": "relay.cronstable.com", "custom_domain": true }],

  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "DEVICE", "class_name": "DeviceState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceState"] }],

  // Non-secret configuration.  The Apple credentials are secrets:
  //   wrangler secret put APNS_TEAM_ID
  //   wrangler secret put APNS_KEY_ID
  //   wrangler secret put APNS_AUTH_KEY   (paste the whole .p8 PEM)
  "vars": {
    "APNS_TOPIC": "ptweezy.cronstable-ios",
    "APNS_ENVIRONMENT": "auto"
  }
}
