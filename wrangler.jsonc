{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cronstable-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // Deploys to <name>.<account>.workers.dev until the custom domain is
  // live.  Once the cronstable.com zone is active on the Cloudflare
  // account, uncomment the route below, set workers_dev to false and
  // redeploy — the relay then answers at https://relay.cronstable.com/.
  "workers_dev": true,
  // "routes": [{ "pattern": "relay.cronstable.com", "custom_domain": true }],

  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "DEVICE", "class_name": "DeviceState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceState"] }],

  // Non-secret configuration.  The Apple credentials are secrets:
  //   wrangler secret put APNS_TEAM_ID
  //   wrangler secret put APNS_KEY_ID
  //   wrangler secret put APNS_AUTH_KEY   (paste the whole .p8 PEM)
  "vars": {
    "APNS_TOPIC": "ptweezy.cronstable-ios",
    "APNS_ENVIRONMENT": "auto"
  }
}
