node_modules/
.wrangler/
dist/

# Runtime + binding types, generated from wrangler.jsonc by `wrangler
# types` (npm run types, and automatically before npm run typecheck).
# Half a megabyte of machine-written declarations that would otherwise
# dominate every diff in a repo meant to be read.
worker-configuration.d.ts

# Local secrets for `wrangler dev`, never committed.
.dev.vars
.dev.vars.*

# Real APNs auth keys must never enter this repo.  The one exception is
# the throwaway key the test suite signs with (generated for tests,
# never registered with Apple).
*.p8
!tests/fixtures/test-apns-key.p8
